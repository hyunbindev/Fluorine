{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Utility Workspace",
  "version": "0.1.1",
  "identifier": "com.acme2.utility",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Utility Workspace", "width": 1000, "height": 700, "minWidth": 640, "minHeight": 480, "decorations": false, "transparent": true, "windowEffects": { "effects": ["acrylic"] } }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] },
  "plugins": { "sql": { "preload": ["sqlite:utility.db"] } }
}
